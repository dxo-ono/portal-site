---
import Layout from '../layouts/Layout.astro'
---

<Layout title="Welcome to Astro.">
  <!-- ヒーロービジュアル -->
  <div class="hero">
    <div class="bg-overlay-image"></div>
    <div class="copy-wrap">
      <div class="copy-inner">
        <div class="copy-left"></div>
        <div class="copy-main">
          見ればわかる<span class="copy-comma">、</span>つながる<span
            class="copy-comma">、</span
          >ひらめ<span class="copy-k">く</span>。
        </div>
        <div class="copy-right"></div>
      </div>
      <div class="copy-main-wave">
        <span class="copy-left-sp">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="15"
            height="19"
            viewBox="0 0 15 19"
            fill="none"
          >
            <path
              d="M14.4334 1.30727H1.14355V18.2216"
              stroke="white"
              stroke-width="0.906122"></path>
          </svg>
        </span>
        <span class="cha-c1">見</span>
        <span class="cha-c2">れば</span>
        <span class="cha-c3">わ</span>
        <span class="cha-c4">か</span>
        <span class="cha-c5">る、つ</span>
        <span class="cha-c6">な</span>
        <span class="cha-c7">が</span>
        <span class="cha-c8">る、</span>
        <span class="cha-c9">ひ</span>
        <span class="cha-c10">ら</span>
        <span class="cha-c11">め</span>
        <span class="cha-c12">く。</span>
        <span class="copy-right-sp">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="15"
            height="18"
            viewBox="0 0 15 18"
            fill="none"
          >
            <path
              d="M0.853516 17.4052H14.1433V0.490952"
              stroke="white"
              stroke-width="0.906122"></path>
          </svg>
        </span>
      </div>
        <div class="copy-sub">－ 社内ポータルサイト －</div>
    </div>
  </div>

  <!-- お知らせ -->
  <main class="main-content">
    <div class="news">
      <div class="news-inner">
        <div class="title-under-border">
          <div class="news-title">お知らせ</div>
        </div>
        <!-- お知らせ一覧リスト -->
        <div class="news-content">
          <ul>
            <li>
              <div class="news-meta-wrap">
                <div class="news-meta">
                  <span class="news-date">2023/01/30</span>
                  <span class="news-label">
                    <span class="news-label-corporate">コーポレート</span>
                  </span>
                </div>
                <div class="news-text">
                  <a href="ページリンク" class="news-page-link"
                    >2022年度下期社員総会開催のお知らせ</a
                  > を公開しました
                </div>
              </div>
            </li>
            <li>
              <div class="news-meta-wrap">
                <div class="news-meta">
                  <span class="news-date">2022/10/31</span>
                  <span class="news-label">
                    <span class="news-label-news">お知らせ</span>
                  </span>
                </div>
                <div class="news-text">
                  <a href="ページリンク" class="news-page-link"
                    >DXO社内ポータル</a
                  > サイトコンセプト
                </div>
              </div>
            </li>
            <li>
              <div class="news-meta-wrap">
                <div class="news-meta">
                  <span class="news-date">2022/10/26</span>
                  <span class="news-label">
                    <span class="news-label-news">お知らせ</span>
                  </span>
                </div>
                <div class="news-text">
                  <a href="ページリンク" class="news-page-link"
                    >2022年上期社員総会ふりかえり</a
                  > を公開しました
                </div>
              </div>
            </li>
            <li>
              <div class="news-meta-wrap">
                <div class="news-meta">
                  <span class="news-date">2022/09/26</span>
                  <span class="news-label">
                    <span class="news-label-news">その他</span>
                  </span>
                </div>
                <div class="news-text">
                  <a href="ページリンク" class="news-page-link"
                    >2022年上期社員総会開催のお知らせ</a
                  > を公開しました
                </div>
              </div>
            </li>
            <li>
              <div class="news-meta-wrap">
                <div class="news-meta">
                  <span class="news-date">2022/09/07</span>
                  <span class="news-label">
                    <span class="news-label-corporate">コーポレート</span>
                  </span>
                </div>
                <div class="news-text">
                  <a href="ページリンク" class="news-page-link"
                    >第11回 NIPPON IT チャリティ駅伝</a
                  > への参加者を募集しています
                </div>
              </div>
            </li>
          </ul>
        </div>

        <!-- お知らせ一覧ボタンCSS -->
        <div class="news-button-container">
          <a href="お知らせ一覧ページリンク" class="news-button">お知らせ一覧</a
          >
        </div>
      </div>
    </div>

    <!-- Cards DXO株式会社について -->
    <div class="card-container">
      <div class="card">
        <a href="社員紹介ページリンク" class="card-link">
          <img src="/images/member@2x.png" alt="社員紹介の画像" />
          <div class="card-text">社員紹介</div>
          <span class="arrow">
            <img src="../images/pseudo.png" alt="矢印の画像" />
          </span>
        </a>
      </div>
      <div class="card">
        <a href="社内報ページリンク" class="card-link">
          <img
            src="/images/report@2x.jpg"
            alt="社内報の画像"
            class="card-link-report"
          />

          <div class="card-text">社内報</div>
          <span class="arrow">
            <img src="../images/pseudo.png" alt="矢印の画像" />
          </span>
        </a>
      </div>
      <div class="card">
        <a href="DXOポータルページリンク" class="card-link">
          <img
            src="/images/logo@2x.png"
            alt="DXO株式会社ポータルの画像"
            class="card-img3"
          />
          <div class="card-text">DXO株式会社ポータルとは</div>
          <span class="arrow">
            <img src="../images/pseudo.png" alt="矢印の画像" />
          </span>
        </a>
      </div>
    </div>
  </main>
</Layout>

---
import Layout from '../layouts/Layout.astro'
---

<Layout title="Welcome to Astro.">
  <!-- ヒーロービジュアル -->
  <div class="hero">
    <div class="bg-overlay-image"></div>
    <div class="copy-wrap">
      <div class="copy-main">「見ればわかる、つながる、ひらめく。」</div>
      <div class="copy-sub">－ 社内ポータルサイト －</div>
    </div>
  </div>

  <!-- お知らせ -->
  <main class="main-content">
    <div class="news">
      <div class="news-inner">
        <div class="title-under-border">
          <div class="news-title">お知らせ</div>
        </div>
        <!-- お知らせ一覧リスト -->
        <div class="news-content">
          <ul>
            <li>
              <div class="news-meta-wrap">
                <div class="news-meta">
                <span class="news-date">2023/01/30</span>
                <span class="news-label">
                  <span class="news-label-corporate">コーポレート</span>
                </span>
                </div>
                <div class="news-text">
                  <a href="ページリンク" class="news-page-link">2022年度下期社員総会開催のお知らせ</a> を公開しました</div>
              </div>
            </li>
            <li>
              <div class="news-meta-wrap">
                <div class="news-meta">
                <span class="news-date">2022/10/31</span>
                <span class="news-label">
                  <span class="news-label-news">お知らせ</span>
                </span>
                </div>
                <div class="news-text">
                  <a href="ページリンク" class="news-page-link">DXO社内ポータル</a> サイトコンセプト
                </div>
              </div>
            </li>
            <li>
              <div class="news-meta-wrap">
                <div class="news-meta">
                  <span class="news-date">2022/10/26</span>
                  <span class="news-label">
                    <span class="news-label-news">お知らせ</span>
                  </span>
                </div>
                <div class="news-text">
                  <a href="ページリンク" class="news-page-link">2022年上期社員総会ふりかえり</a> を公開しました
                </div>
              </div>
            </li>
            <li>
              <div class="news-meta-wrap">
                <div class="news-meta">
                <span class="news-date">2022/09/26</span>
                <span class="news-label">
                  <span class="news-label-news">その他</span>
                </span>
                </div>
                <div class="news-text">
                  <a href="ページリンク" class="news-page-link">2022年上期社員総会開催のお知らせ</a> を公開しました
                </div>
              </div>
            </li>
            <li>
              <div class="news-meta-wrap">
                <div class="news-meta">
                <span class="news-date">2022/09/07</span>
                <span class="news-label">
                  <span class="news-label-corporate">コーポレート</span>
                </span>
                </div>
                <div class="news-text">
                  <a href="ページリンク" class="news-page-link">第11回 NIPPON IT チャリティ駅伝</a> への参加者を募集しています
                </div>
              </div>
            </li>
          </ul>
        </div>

        <!-- お知らせ一覧ボタンCSS -->
        <div class="news-button-container">
          <a href="お知らせ一覧ページリンク" class="news-button">お知らせ一覧</a
          >
        </div>
      </div>
    </div>

    <!-- DXO株式会社について -->
    <div class="card-container">
      <!-- まとめて指定するCSS class統一 -->
      <div class="card">
        <a href="社員紹介ページリンク" class="card-link">
          <img src="/images/member.png" alt="社員紹介の画像" />
          <div class="card-text">社員紹介</div>
        </a>
      </div>
      <div class="card">
        <a href="社内報ページリンク" class="card-link">
          <img src="/images/report.jpg" alt="社内報の画像" />
          <div class="card-text">社内報</div>
        </a>
      </div>
      <div class="card">
        <a href="DXOポータルページリンク" class="card-link">
          <img src="/images/logo.png" alt="DXO株式会社ポータルの画像" />
          <div class="card-text">DXO株式会社ポータルとは</div>
        </a>
      </div>
    </div>
  </main>
</Layout>
